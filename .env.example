# EmailJS — https://emailjs.com (free: 200 emails/month)
# 1. Create account → Add Email Service (Gmail) → get Service ID
# 2. Create two templates (see README for variable names) → get Template IDs
# 3. Account → API Keys → get Public Key

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_CUSTOMER_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_ADMIN_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxx
VITE_ADMIN_EMAIL=contact@horizongarage.com
